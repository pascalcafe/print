{
  "name": "@easyprint/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n build,serve -c yellow,cyan \"nest build --watch\" \"nodemon --watch dist/apps/api/src --ext js --delay 2 --exec node dist/apps/api/src/main.js\"",
    "build": "nest build",
    "start": "node dist/apps/api/src/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "pnpm exec prisma generate --schema ../../packages/prisma/schema.prisma",
    "prisma:migrate": "pnpm exec prisma migrate dev --schema ../../packages/prisma/schema.prisma",
    "prisma:deploy": "pnpm exec prisma migrate deploy --schema ../../packages/prisma/schema.prisma",
    "generate:openapi": "ts-node --transpile-only ./scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@easyprint/shared": "workspace:*",
    "@nestjs/common": "^10.4.2",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.2",
    "@nestjs/serve-static": "^4.0.2",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^6.1.0",
    "multer": "^1.4.5-lts.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@nestjs/swagger": "^6.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/passport-jwt": "^4.0.1",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "prisma": "^6.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
