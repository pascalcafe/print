{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@easyprint/shared/*": ["packages/shared/src/*"],
      "@easyprint/shared": ["packages/shared/src/index.ts"],
      "@easyprint/ui/*": ["packages/ui/src/*"],
      "@easyprint/ui": ["packages/ui/src/index.ts"]
    }
  }
}
