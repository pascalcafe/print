{
  "name": "easyprint",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @easyprint/prisma generate",
    "db:migrate": "pnpm --filter @easyprint/prisma migrate:deploy",
    "db:migrate:dev": "pnpm --filter @easyprint/prisma migrate:dev"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
